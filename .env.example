# ─── LLM ────────────────────────────────────────────────────────────────────
# QALoop defaults to Anthropic for both the LLM agents (1, 3) and the
# Claude Computer Use sandbox driver (Agents 2, 4). Set the same key here.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Other LLM providers wired but not used by default. Set LLM_PROVIDER
# to switch the agents (Agents 2 and 4 always use Anthropic regardless).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=multiagent
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/multiagent
# Host port mapping (override if 5432 is already used locally).
DB_PORT=5432

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
# Host port mapping.
REDIS_PORT=6380

# ─── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
# Inside the api container the port is always 8000. This is the host
# port mapping; `make up` and `make dev` use 8001 by default to avoid
# colliding with anything else listening on 8000.
API_PORT=8001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Web ─────────────────────────────────────────────────────────────────────
# Build-time URL the frontend uses to reach the API. Must point at the
# API_PORT above.
NEXT_PUBLIC_API_URL=http://localhost:8001
WEB_PORT=3000

# ─── claude-sandbox-svc ──────────────────────────────────────────────────────
# HMAC key used to sign live-view (noVNC) URLs. Generate with:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
TOKEN_SECRET=dev-secret-change-me
# Sandbox runner image tag. Build locally with:
#   docker build -t qa-sandbox:local apps/claude-sandbox-svc/docker
SANDBOX_IMAGE=qa-sandbox:local
SANDBOX_MEM_LIMIT=2g
SANDBOX_CPUS=1.0
# Concurrent sandbox containers. Bumping this raises memory usage
# proportionally — each container uses up to SANDBOX_MEM_LIMIT.
MAX_CONCURRENT_TASKS=2
DEFAULT_TIMEOUT_SECONDS=1800
# Days terminal tasks are kept on disk before the hourly sweep prunes
# them. Set 0 to disable.
RETENTION_DAYS=7
SANDBOX_PORT=8100
SANDBOX_PUBLIC_BASE_URL=http://localhost:8100
VNC_PROXY_MODE=proxy
VNC_BIND_HOST=127.0.0.1
SANDBOX_DEFAULT_MODEL=claude-haiku-4-5-20251007

# ─── API → claude-sandbox-svc integration ────────────────────────────────────
# How the api container reaches the sandbox service. Inside docker-compose
# this resolves to the service hostname; from the host use http://localhost:8100.
SANDBOX_BASE_URL=http://claude-sandbox-svc:8000
# When false, Agent 2 falls back to the manual interrupt() handoff used during
# Phase 3 development (resume the run via POST /api/runs/:id/feedback with
# {"workspace_outputs": {...}}).
SANDBOX_ENABLED=true
SANDBOX_POLL_INTERVAL_SECONDS=3
# Per-task wall-clock cap for Agent 2's sandbox. Beyond this Agent 2
# soft-succeeds if it has findings.md, otherwise the run fails.
SANDBOX_DEFAULT_TIMEOUT_SECONDS=360
SANDBOX_MAX_ITERATIONS=12

# Agent 2 specifically uses a faster model than Agent 4 because it only
# clicks around and writes a markdown summary; intelligence isn't critical.
# Agent 4 (script bundle generation) keeps the default sandbox model.
SANDBOX_AGENT2_MODEL=claude-haiku-4-5-20251007
SANDBOX_AGENT2_MAX_TOKENS=2048
SANDBOX_AGENT2_RECENT_IMAGES=2
SANDBOX_AGENT2_MAX_ITERATIONS=15

# ─── opencode MCP (optional, contributors only) ──────────────────────────────
# opencode.json wires up the @21st-dev/magic MCP server which expects an
# API key in this env var. Leave blank if you don't use opencode locally.
MAGIC_MCP_API_KEY=
