# ─── LLM ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=multiagent
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/multiagent

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ─── Web ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── claude-sandbox-svc ──────────────────────────────────────────────────────
# Anthropic API key forwarded to spawned sandbox containers.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# HMAC key used to sign live-view (noVNC) URLs. Generate with:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
TOKEN_SECRET=dev-secret-change-me
# Sandbox image tag. Build locally with:
#   docker build -t qa-sandbox:local apps/claude-sandbox-svc/docker
SANDBOX_IMAGE=qa-sandbox:local
SANDBOX_MEM_LIMIT=2g
SANDBOX_CPUS=1.0
MAX_CONCURRENT_TASKS=2
DEFAULT_TIMEOUT_SECONDS=1800
RETENTION_DAYS=7
SANDBOX_PORT=8100
SANDBOX_PUBLIC_BASE_URL=http://localhost:8100
VNC_PROXY_MODE=proxy
VNC_BIND_HOST=127.0.0.1
SANDBOX_DEFAULT_MODEL=claude-sonnet-4-5-20250929
